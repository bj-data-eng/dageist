{
  "outer": ["select", "filter", "sort", "join_left", "join_right", "pivot_aggregate"],
  "nested": ["over.partition_by", "over.order_by", "condition.predicate", "condition.value"],
  "rules": [
    "condition-predicate-is-boolean",
    "duration-is-valid",
    "element-only-in-pivot-aggregate",
    "filter-predicate-is-boolean",
    "join-key-names-are-not-repeated",
    "key-is-elementwise",
    "pattern-is-valid",
    "pivot-aggregate-gives-one-value",
    "replacement-values-match-in-number"
  ],
  "stages": ["schema", "rows", "empty"],
  "conditionStates": ["when", "then", "chainedWhen", "chainedThen"],
  "valueShapes": ["one", "many"],
  "changes": ["added", "replaced"],
  "errorKinds": ["noSuchStep", "notRun", "refused", "limit", "unreadable", "unknownName", "failed"],
  "applies": ["expression", "frame", "function", "condition"],
  "valueTypes": ["integer", "float", "string", "date", "any"],
  "settings": [
    "unset",
    "flag",
    "integer",
    "float",
    "text",
    "word",
    "field",
    "element",
    "comparison",
    "list",
    "pairs"
  ]
}
